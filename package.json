{
  "name": "ugc-streaming-gof-observer-subequipe-03",
  "version": "1.0.0",
  "description": "StreamSentry: Implementação Real do Padrão GoF Observer com Moderação Reativa (AutoMod, Gore, Nudez, DMCA) e Concorrência",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "server": "tsx src/server.ts",
    "demo": "tsx src/demo.ts",
    "benchmark": "tsx src/benchmark.ts",
    "interactive": "tsx src/interactive.ts",
    "web": "tsx src/webServer.ts",
    "test": "tsx --test src/**/*.test.ts tests/*.test.ts",
    "demo:autenticacao": "tsx src/autenticacao/demo.ts",
    "test:autenticacao": "tsx --test tests/*.test.ts",
    "typecheck:autenticacao": "tsc --noEmit -p tsconfig.autenticacao.json",
    "check:autenticacao": "npm run typecheck:autenticacao && npm run test:autenticacao"
  },
  "keywords": [
    "design-patterns",
    "gof",
    "observer",
    "strategy",
    "moderation",
    "automod",
    "nsfw-detection",
    "dmca",
    "twitch",
    "youtube",
    "kick",
    "chain-of-responsibility",
    "authentication",
    "totp"
  ],
  "author": "SubEquipe 03 - Desenho de Software (UnB Gama)",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.5.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
